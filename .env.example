# Copy to api/.env for local dev. Never commit real values.
NODE_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:5173
DATABASE_URL=sqlite:./data/dev.sqlite
# Production secrets: 32+ random chars each (openssl rand -base64 48)
JWT_SECRET=
FILE_SIGNING_SECRET=
MFA_ENCRYPTION_KEY=
DEFAULT_COMMUNITY_NAME=My Community
DEFAULT_COMMUNITY_SLUG=my-community
# Management company inbox. MUST be set before any real use.
MGMT_EMAIL=
EMAIL_PROVIDER=console   # console | smtp | acs
EMAIL_FROM=
SMTP_URL=
ACS_ENDPOINT=
REPLY_DOMAIN=
INBOUND_EMAIL_SECRET=
# Unraid/Watchtower only: shared secret so update notices can be posted to Admin > System (any long random string)
WATCHTOWER_SECRET=
STORAGE_PROVIDER=local   # local | azure
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=photos
REQUIRE_ADMIN_MFA=true
AI_SUGGEST_ENABLED=false # sends photos to Anthropic (outside UAE): read docs/privacy-pdpl.md first
ANTHROPIC_API_KEY=
# AirCon tab (optional, read-only; ids like tower1:fresh_air_temperature are imported hourly statistics): Home Assistant address, a long-lived token from a dedicated NON-admin HA user, and the sensor layout as one line of JSON
HA_URL=
HA_TOKEN=
HA_AIR_SENSORS=   # a tower can use "prefix":"sensor.<device>_" to pick up every uHoo sensor. Example:  {"outside":{"temperature":"sensor.outside_temp","humidity":"sensor.outside_humidity"},"towers":[{"name":"MR 1","temperature":"sensor.thermo_hygrometer_temperature","humidity":"sensor.thermo_hygrometer_humidity"}]}
# Optional: minutes before an AirCon reading is shown as an old reading (default 120; battery Zigbee sensors can go about an hour between updates)
HA_STALE_MINUTES=120
